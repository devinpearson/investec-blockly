{
  "name": "investec-blockly",
  "version": "1.0.0",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:mcp": "vite build --config mcp/vite.config.ts",
    "mcp": "node mcp/dist/investec-blockly-mcp.cjs",
    "mcp:http": "node mcp/dist/investec-blockly-mcp.cjs --http 3020",
    "skill:reference": "npm run build:mcp && node mcp/dist/investec-blockly-mcp.cjs skill-files skills/investec-card-snippets",
    "test:mcp": "npm run build:mcp && node --test mcp/test/*.test.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@blockly/theme-modern": "^5.0.5",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.7",
    "blockly": "^10.4.3",
    "highlight.js": "^11.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "investec-blockly-mcp": "mcp/dist/investec-blockly-mcp.cjs"
  }
}
